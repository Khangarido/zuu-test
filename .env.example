# Copy to `.env.local` for local dev, or to `deploy/.env` on the VPS.
# Placeholders only. Never commit real values (.env* is git-ignored).
# On the VPS, do not wrap values in quotes (Docker env_file keeps them literally).

# ── Supabase ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* are inlined into the bundle at BUILD time. Changing them means
# rebuilding the image (see deploy/README.md).
# Self-hosted: the public API host served by the reverse proxy, e.g.
# https://supabase.zuutest.site. The cookie name is derived from its first
# label (sb-<label>-auth-token), and the browser AND server both use this URL.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-jwt
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-jwt

# ── App ─────────────────────────────────────────────────────────────────────
# Canonical public URL. Used as the BYL checkout return URL (build-time inlined).
NEXT_PUBLIC_APP_URL=https://example.com

# ── Email ───────────────────────────────────────────────────────────────────
# Not read by src/ today. Self-hosted GoTrue sends auth mail itself over SMTP
# (see deploy/supabase/.env.example, SMTP_*). Kept for the existing Vercel setup.
RESEND_API_KEY=replace-with-resend-key

# ── BYL payments ────────────────────────────────────────────────────────────
BYL_TOKEN=replace-with-byl-token
BYL_PROJECT_ID=replace-with-byl-project-id
BYL_PRICE_ID=replace-with-byl-price-id
BYL_WEBHOOK_SECRET=replace-with-byl-webhook-secret

# ── Upstash Redis (REST, unchanged; stays hosted) ───────────────────────────
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# ── Deploy only (VPS, read by deploy/docker-compose.app.yml and deploy.sh) ──
# Host port the app binds on 127.0.0.1. Pick one nothing else uses (`ss -tlnp`).
APP_PORT=3100
# Image name and tag. For GHCR builds: ghcr.io/<owner>/<repo> (lowercase).
APP_IMAGE=zuu-app
APP_TAG=latest
