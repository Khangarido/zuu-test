# Settings to apply on top of upstream's docker/.env for the zuutest.site stack.
# setup.sh applies the non-secret ones for you; this file documents them.
# Secrets (JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, POSTGRES_PASSWORD,
# DASHBOARD_PASSWORD, ...) are generated on the server by upstream's
# utils/generate-keys.sh and never leave it. Do not commit the real .env.

# Load upstream's compose file + our trimmed overlay (add :docker-compose.edge.yml
# if the host proxy runs in Docker).
COMPOSE_FILE=docker-compose.yml:docker-compose.zuu.yml

# Loopback port for the gateway. Pick one that `ss -tlnp` shows free.
API_GW_HTTP_PORT=8100

# Public API host (served by the host proxy over HTTPS). Its FIRST LABEL becomes
# the auth cookie name: sb-supabase-auth-token for supabase.zuutest.site.
SUPABASE_PUBLIC_URL=https://supabase.zuutest.site
API_EXTERNAL_URL=https://supabase.zuutest.site/auth/v1

# Where users land after clicking emailed links. Add every origin that serves the
# app (apex, www, staging). `**` is a GoTrue glob.
SITE_URL=https://zuutest.site
ADDITIONAL_REDIRECT_URLS=https://zuutest.site/**,https://www.zuutest.site/**,https://next.zuutest.site/**

# The app uses email+password with a 6-digit email OTP. No phone, no anonymous.
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
DISABLE_SIGNUP=false

# SMTP. If hosted Supabase used Resend for auth mail, reuse it (Resend SMTP:
# host smtp.resend.com, port 465, user "resend", password = the Resend API key).
# SMTP_ADMIN_EMAIL / sender must be on a domain verified in Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=replace-with-resend-api-key
SMTP_ADMIN_EMAIL=no-reply@zuutest.site
SMTP_SENDER_NAME=Zuu Academy

# Overlay knobs (optional)
# AUTH_RATE_LIMIT_EMAIL_SENT=300
# MAILER_OTP_EXP=3600
# MAILER_SUBJECT_CONFIRMATION=Баталгаажуулах код
# MAILER_SUBJECT_RECOVERY=Нууц үг шинэчлэх
# EDGE_NETWORK=proxy_edge
